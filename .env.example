# Copia este fichero a .env y ajusta las rutas a tu máquina. .env no se sube nunca.

# Carpeta paquet/ del material del reto (CSV de entrada y escenaris/).
HORARIS_PAQUET=./repte-horaris-escola/paquet

# Fichero SQLite que generan las migraciones y la carga. No se sube nunca: contiene los datos del paquete.
HORARIS_DB=./horaris.db

# Carpeta que contiene el paquete horaris/ del verificador oficial.
# Si no se define, se usa la carpeta padre de HORARIS_PAQUET.
HORARIS_VERIFICADOR=./repte-horaris-escola

# Solver CP-SAT (opcional)
SOLVER_MAX_TIME_S=300
SOLVER_MAX_CONCURRENT_JOBS=1
PAQUET_ROOT=

# Backend Node (backend/). Solo lectura, sin autenticación: no lo expongas a la red.
# Dirección donde escucha.
HOST=127.0.0.1

# Puerto donde escucha.
PORT=3000

# Único origen permitido por CORS (el frontend de desarrollo).
CORS_ORIGIN=http://localhost:5173

# Nivel de log del backend.
LOG_LEVEL=info
