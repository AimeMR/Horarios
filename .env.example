# ==============================================================================
# CONFIGURACIÓN DE IA LOCAL Y CHATBOT
# ==============================================================================
# Endpoint del servidor de IA local:
# - Ollama (OpenAI compatible): http://localhost:11434/v1/chat/completions
# - Ollama (Nativo chat):       http://localhost:11434/api/chat
# - LM Studio (Local server):   http://localhost:1234/v1/chat/completions
# - LocalAI / vLLM:             http://localhost:8080/v1/chat/completions
VITE_LOCAL_AI_URL=http://localhost:11434/v1/chat/completions

# API Key para autenticación con la IA local (opcional según el servidor configurado)
VITE_LOCAL_AI_KEY=

# Modelo de lenguaje a utilizar (ej. llama3, mistral, deepseek-r1, qwen2.5)
VITE_LOCAL_AI_MODEL=llama3

